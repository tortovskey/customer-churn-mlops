APP_NAME="Customer Churn MLOps System"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://churn_user:churn_password@postgres:5432/churn_db
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=customer_churn_experiments
MODEL_NAME=customer_churn_random_forest
ALLOW_AUTO_TRAIN=true
TRAINING_ROWS=2500
TRAINING_RANDOM_STATE=42
LOG_LEVEL=INFO

